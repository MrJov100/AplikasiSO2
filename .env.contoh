# Salin berkas ini menjadi .env lalu isi kata sandinya.
# .env TIDAK boleh ikut ke Git.

PG_HOST=localhost
PG_PORT=5432
PG_DB=so2_jabodetabek
PG_USER=so2_app
PG_PASSWORD=GANTI_KATA_SANDI_INI

# Folder berkas ASLI dari Colab (Gxx_skenario2_model.joblib).
# Hanya dipakai konversi_model.py, sekali jalan.
FOLDER_MODEL_ASLI=C:/Penyimpanan Utama/Dekstop/SkenarioStackingEnsemble/Skenario2/model

# Folder berkas PORTABEL yang dipakai aplikasi:
# Gxx_xgb.ubj + Gxx_bundel.joblib + metadata_model.json
FOLDER_MODEL=C:/Penyimpanan Utama/Dekstop/SkenarioStackingEnsemble/Skenario2/model_portabel

# Penanda versi model beku, ditulis ke kolom prediksi.versi_model
VERSI_MODEL=stacking-s2-20260731

# Menit keberangkatan penjadwal tiap jam (0-59).
MENIT_JADWAL=10

# Kunci penanda token akses. WAJIB diganti dengan teks acak panjang.
# Hasilkan dengan:  python -c "import secrets;print(secrets.token_urlsafe(48))"
KUNCI_TOKEN=ganti-kunci-ini-pada-env
MASA_TOKEN_JAM=12
